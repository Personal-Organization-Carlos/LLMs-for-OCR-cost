              "content": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Diario Official — 1 de Abril de 1910</title>\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    background: #f4f0e5;\n    color: #171511;\n    font-family: \"Times New Roman\", Georgia, serif;\n  }\n  .page {\n    width: 1500px;\n    max-width: 100%;\n    margin: 0 auto;\n    padding: 72px 54px 38px;\n    background:\n      radial-gradient(circle at 13% 18%, rgba(70,55,25,.05) 0 1px, transparent 2px),\n      radial-gradient(circle at 82% 62%, rgba(70,55,25,.04) 0 1px, transparent 2px),\n      #f8f5eb;\n  }\n  .masthead {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    align-items: end;\n    padding: 0 32px 9px;\n    border-bottom: 3px solid #181611;\n    font-size: 22px;\n    font-weight: bold;\n    letter-spacing: .5px;\n  }\n  .masthead .center {\n    text-align: center;\n    font-size: 25px;\n    letter-spacing: 1px;\n  }\n  .masthead .right { text-align: right; }\n\n  .columns {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    border-bottom: 3px solid #181611;\n  }\n  .column {\n    min-height: 620px;\n    padding: 17px 16px 18px;\n    font-size: 21px;\n    line-height: 1.08;\n    text-align: justify;\n  }\n  .column + .column { border-left: 2px solid #181611; }\n  p { margin: 0 0 13px; text-indent: 28px; }\n  .no-indent { text-indent: 0; }\n  .section-title {\n    margin: 5px 0 20px;\n    text-align: center;\n    font-size: 17px;\n    font-weight: normal;\n    letter-spacing: 1px;\n  }\n  .sub-title {\n    margin: 0 0 20px;\n    text-align: center;\n    font-size: 19px;\n    font-style: italic;\n  }\n  .appeals-title {\n    text-align: center;\n    margin: 0 0 18px;\n    font-size: 22px;\n    font-style: italic;\n  }\n  .decision {\n    margin-top: -8px;\n    padding-left: 22px;\n    text-indent: 0;\n  }\n  .small-rule {\n    width: 170px;\n    margin: 92px auto 0;\n    borde