            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.66,
                0.189,
                0.983,
                0.225
            ],
            "angle": 0,
            "content": "João Rodrigues Ferraz.—De acordo com os pareceres restitua-se a quantia de 21\\$000.",
