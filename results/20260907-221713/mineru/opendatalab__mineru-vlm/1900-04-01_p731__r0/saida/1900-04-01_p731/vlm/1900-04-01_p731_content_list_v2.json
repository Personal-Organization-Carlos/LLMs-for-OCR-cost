                340,
                507
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Por decreto da mesma data, foram também creados dois logaras identicos na seção feminina do grupo da Foxina."
