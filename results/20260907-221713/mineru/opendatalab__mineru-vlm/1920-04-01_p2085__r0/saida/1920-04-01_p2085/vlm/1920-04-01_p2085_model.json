                0.951,
                0.299
            ],
            "angle": 0,
            "content": "Oscar Rodrigues Alves.",
            "merge_prev": false
        },
        {
            "type": "title",
            "bbox": [
                0.655,
                0.331,
                0.83,
                0.352
            ],
            "angle": 0,
            "content": "INTERIOR"
        },
        {
            "type": "text",
            "bbox": [
                0.557,
                0.364,
                0.81,
                0.376
            ],
            "angle": 0,
            "content": "Por decretos de 31 do correnté :",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.509,
                0.376,
                0.976,
                0.424
            ],
            "angle": 0,
            "content": "foram aposentados o dr. Augusto Militão Pacheco, inspector sanitario da Capital e o sr. Antonio Egydio Martins, 1.º escripturário da Repartição de Estatística e Archivo do Estado;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.509,
                0.423,
                0.976,
                0.459
            ],
            "angle": 0,
            "content": "- foi removido o inspector sanitario da Delegacia de Saúde de Compinas, dr. João Paes Leme de Monlevade, para igual cargo-nesta Capital;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.509,
                0.458,
                0.976,
                0.505
            ],
            "angle": 0,
            "content": "foram uomeados inspectores sanitarios os drs. João Thomaz Monteiro da Silva, para S. Carlos; Daniel Martins, para Botucatú; Justiniano Lisbôa e Jorge Dutra Fragoso, para Santos;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.508,
                0.504,
                0.975,
                0.54
            ],
            "angle": 0,
            "content": "foi nomeado o sr. Alfredo de Barros Santos, para exercer o cargo de auxiliar do director da Escola Profissional Masculino da Capital;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.509,
                0.539,
                0.975,
                0.575
            ],
            "angle": 0,
            "content": ". foi promovido a 2.º escripturario da Directoria Geral do Serviço Sanitario, o 3.º escripturario da mesma repartição, sr. Bernardino de Campos Araujo;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.509,
                0.574,
                0.975,
                0.61
            ],
            "angle": 0,
            "content": "foi nomeado o dr. Henrique Jorge Guedes para exercer o cargo de lente substituto interino da 2.ª secção da Escola Polytechnica de S. Paulo;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.508,
                0.609,
                0.975,
                0.691
            ],
            "angle": 0,
            "content": "foi transferido o dr. Francisco Pereira Ramos; lente cathedratico das cadeiras reunidas de Physica Industrial e Electrotechnica (1.\\( ^{a} \\) parte) da Escola Polytechnica de São Panlo, para lente cathedratico da cadeira isolada de Economia Política. Elementos de Estatisca. Noções de Direito Administrativo da mesma Escola, de acordo com art. 20, § 3.\\( ^{o} \\) do Decreto n. 2.931, de 12 de Junho de 1918;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.508,
                0.691,
                0.973,
                0.715
            ],
            "angle": 0,
            "content": "foi annexada ao grupo escolar de Pirajú a escola mixta urbaua, das Paivas, da mesma localidade;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.508,
                0.714,
                0.973,
                0.738
            ],
            "angle": 0,
            "content": "foi dada a denominação de «Francisco Simões», ao grupo escolar de Dois Corregos;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.508,
                0.737,
                0.973,
                0.773
            ],
            "angle": 0,
            "content": "foi effectivado no cargo de director do grupo escolar de Tambahú, o actual director interino, professor Mancel Nogueira de Carvalho;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.772,
                0.973,
                0.819
            ],
            "angle": 0,
            "content": "foram nomeadas adjunctas dos grupos escolares de Ribeirão Bonito e Brotas, as seguintes professoras dd. Maria Paula de Paula Sousa, Maria Silveira Almeida, respectivamente;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.818,
                0.972,
                0.842
            ],
            "angle": 0,
            "content": "foram removidos, a pedido, os seguintes adjunctos de grupos escolares:",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.842,
                0.971,
                0.866
            ],
            "angle": 0,
            "content": "d. Maria Augusta de Andrade Justo, do de Brotas para o «Antonio Padilha», de Sorocab;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.865,
                0.971,
                0.889
            ],
            "angle": 0,
            "content": "d. Dulce de Barros Pereira, de de Brotas, para o «Visconde de Porto Seguro», de Sorocaba;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.888,
                0.971,
                0.913
            ],
            "angle": 0,
            "content": "Luiz do Amaral Waguer, do «Antonio Padilha», de Sorocaba, para o de Brotas;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.912,
                0.971,
                0.935
            ],
            "angle": 0,
            "content": "d. Marianna Mastroandréa, do «Visconde de Porto Seguro», de Sorocaba, para o de Brotas;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.507,
                0.935,
                0.971,
                0.959
            ],
            "angle": 0,
            "content": "d. Edemea Rudge Ramos Parada, do de Belémzinho, para o de S. João. ambos desta Capital;",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.506,
                0.959,
                0.971,
                0.995
            ],
            "angle": 0,
            "content": "foram exoneradas, a pedido, do cargo de adjunctas do grupo escolar do Bebedouro, d. Luiza Oliveira Algodoal e d, Tamilde Rossi Magalhães, do 1.º de Araraquara;",
            "merge_prev": false
        }
