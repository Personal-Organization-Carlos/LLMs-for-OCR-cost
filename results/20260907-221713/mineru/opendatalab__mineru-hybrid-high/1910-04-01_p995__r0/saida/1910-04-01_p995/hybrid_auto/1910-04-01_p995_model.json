                0.291,
                0.218,
                0.304
            ],
            "angle": 0,
            "content": "Embargos"
        },
        {
            "type": "text",
            "bbox": [
                0.04,
                0.313,
                0.334,
                0.371
            ],
            "angle": 0,
            "content": "N. 5597—Capital—Embargante, A. Weinberg; c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c. c.\nG. Lunsille & Comp; relator, o. r. Mcirelles Reis.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.042,
                0.371,
                0.334,
                0.397
            ],
            "angle": 0,
            "content": "Julgaram subsistente a desistencia dos embargos.",
            "merge_prev": false
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.425,
                0.076,
                0.55,
                0.09
            ],
            "angle": 0,
            "content": "Appellações cíveis"
        },
        {
            "type": "text",
            "bbox": [
                0.339,
                0.098,
                0.635,
                0.145
            ],
            "angle": 0,
            "content": "N. 5561—Piracicaba—Appelante, Thomiz Alonso Knoso; appellada, d. Laurinda Alves de Oliveira; relator, o sr. Francisco Saldenha.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.356,
                0.145,
                0.635,
                0.158
            ],
            "angle": 0,
            "content": "Converteram o julgamesto em diligência.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.34,
                0.158,
                0.636,
                0.203
            ],
            "angle": 0,
            "content": "N. 6057—Capital—A. pellante, o juiz do de direito; appellados, Theodoro Bubra- ner e sua mulher; rolater, o sr. Ferreira França.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.357,
                0.203,
                0.506,
                0.215
            ],
            "angle": 0,
            "content": "Negaram provimento.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.342,
                0.214,
                0.636,
                0.26
            ],
            "angle": 0,
            "content": "N. 6914—Capital—Appellante, Thomé Gomes Ferreira; appellado, Francisco de Souza Franco; relator, o sr. Juvenal Malheircs.",
            "merge_prev": false
        },
        {
