        },
        {
            "type": "text",
            "bbox": [
                0.035,
                0.077,
                0.329,
                0.113
            ],
            "angle": 0,
            "content": "O sr. Gabriel Gomide ao sr. Scuz: e Castro, as civeis 5605 do Santos, 5609 do Piracicaba e 5772 da Cospital.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.035,
                0.113,
                0.33,
                0.183
            ],
            "angle": 0,
            "content": "O sr. Firmino Whitacker ao sr. Gabriel Gemide, as cíveis 5184 de Piracicaba, 5648 de Rio Claro, 5441 de Santa Izabel, 5003 de Jaboticabal, 5352 de Agudos, 6023 de Campicas, 5180 e 5368 de Santos, 5729, 5862, 5687, 5339, 6415 e 5787 da Capital.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.037,
                0.188,
                0.331,
                0.259
            ],
            "angle": 0,
            "content": "--O sr. procurador geral do Estado deu parecer nas app llações cíveis ns. 5564, de Espírito Santo do Finhal e 5870 de São Carlos a nos embargos 2270 da Capital, 5804 de Ibitingu, 5502 e 5735 de Jaboticabal.",
            "merge_prev": false
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.14,
                0.269,
                0.23,
                0.28
            ],
            "angle": 0,
            "content": "JULAMENTOS"
        },
