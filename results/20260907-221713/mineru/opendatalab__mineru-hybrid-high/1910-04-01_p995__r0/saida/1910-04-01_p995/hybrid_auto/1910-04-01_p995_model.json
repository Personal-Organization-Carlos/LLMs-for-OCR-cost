                0.1
            ],
            "angle": 0,
            "content": "ACTOS FEDERAES"
        },
        {
            "type": "text",
            "bbox": [
                0.662,
                0.122,
                0.922,
                0.148
            ],
            "angle": 0,
            "content": "DECRETO N. 7917—DE 24 DE MARÇO\nDE 1910",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.647,
                0.158,
                0.94,
                0.183
            ],
            "angle": 0,
            "content": "Creia o Registro e Archivo Geral de Marcas\npara animaes",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.646,
                0.191,
                0.941,
                0.237
            ],
            "angle": 0,
            "content": "O Presidente da República dos Estados Unidos do Brazil, em execução da lei número 1606, de 29 de Dezembro de 1906, decretas:",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.647,
                0.238,
                0.942,
                0.317
            ],
            "angle": 0,
            "content": "Artigo 1.º E' creado o Registro e Archivo Garal de Marcas para animaes de raça bovina, cavaliar e muar, do acordo com o regulamento que com esta baixa, assignado pelo ministro do Estado dos Negócios da Agricultura, Industria e Commeria.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.648,
                0.317,
                0.943,
                0.34
            ],
            "angle": 0,
            "content": "Artigo 2.º Revogam-se as disposições em contrário.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.649,
                0.34,
                0.944,
                0.365
            ],
            "angle": 0,
            "content": "Rio de Janeiro, 24 de Março de 1519, 89.º da Independência e 22.º da República.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.675,
                0.369,
                0.777,
                0.381
            ],
            "angle": 0,
            "content": "Nilo Propanha",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.675,
                0.381,
                0.944,
                0.395
            ],
            "angle": 0,
            "content": "Rodolpho Nogueira da Rocha Miranda.",
            "merge_prev": false
        },
