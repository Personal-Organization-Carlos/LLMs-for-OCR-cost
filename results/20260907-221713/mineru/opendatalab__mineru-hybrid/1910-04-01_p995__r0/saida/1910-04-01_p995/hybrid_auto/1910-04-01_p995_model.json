            "content": "Sexta-feira, 1"
        },
        {
            "type": "header",
            "bbox": [
                0.404,
                0.044,
                0.57,
                0.061
            ],
            "angle": 0,
            "content": "DIARIO OFFICIAL"
        },
        {
            "type": "header",
            "bbox": [
                0.787,
                0.042,
                0.919,
                0.06
            ],
            "angle": 0,
            "content": "Abril 1910~995."
        },
        {
            "type": "text",
            "bbox": [
                0.033,
                0.076,
                0.331,
                0.114
            ],
            "angle": 0,
            "content": "O sr. Gabriel Gomide ao sr. Scuzs e Castro, as civeia 5605 do Santos, 5609 do Piracicaba e 577) da Capital.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.034,
                0.112,
                0.331,
                0.185
            ],
            "angle": 0,
            "content": "O sr. Firmino Whitacker ao sr. Gabriel Gemide, as cíveis 5184 de Piracicaba, 5648 de Rio Claro, 5441 de Santa Izabel, 5003 de Jaboticabal, 5352 de Agudos, 6023 de Campicas, 5180 e 5368 de Santos, 5729, 5862, 5687, 5339, 5415 e 5787 da Capital.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.035,
                0.187,
                0.333,
                0.261
            ],
            "angle": 0,
            "content": "--O sr. procurador geral do Estado deu parecer nas app llações cíveis ns. 5564, de Espírito Santo do Finhal e 5870 de São Carlos e nos embargos 2270 da Capital, 5804 de Ibitingu, 5502 e 5735 de Jaboticabal.",
            "merge_prev": false
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.139,
                0.268,
                0.233,
                0.282
            ],
            "angle": 0,
            "content": "JULGAMENTOS"
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.152,
                0.291,
                0.221,
                0.305
            ],
            "angle": 0,
            "content": "Embargos"
        },
        {
            "type": "text",
            "bbox": [
                0.039,
                0.312,
                0.336,
                0.372
            ],
            "angle": 0,
            "content": "N. 5597—Capital—Embargante, A. Wainberg; cubragadas, A Companhia Francaze das Indian e do Estremo Oriente e G. Lunsille & Comp; relator, o sr. Meirelles Reis.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.04,
                0.37,
                0.336,
                0.399
            ],
            "angle": 0,
            "content": "Julgaram subsistente a desistencia dos embargos.",
            "merge_prev": false
        },
        {
            "type": "paragraph_title",
            "bbox": [
                0.422,
                0.075,
                0.552,
                0.092
            ],
            "angle": 0,
            "content": "Appellações cíveis"
        },
        {
            "type": "text",
            "bbox": [
                0.337,
                0.097,
                0.636,
                0.147
            ],
            "angle": 0,
            "content": "N. 5561—Piracicaba—Appelante, Thomiz Alonso Knoso; appellada, d. Laurinda Alves de Oliveira; relator, o er. Francisco Saldanha.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.337,
                0.146,
                0.638,
                0.204
            ],
            "angle": 0,
            "content": "Converteram o julgamento em diligencia.\nN. 6057—Capital—A. pellante, o juiz de\nde direito; appellados, Thodoró Bubra-\nner e sua mulher; relater, o sr. Ferreira\nFrança.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.355,
                0.203,
                0.509,
                0.215
            ],
            "angle": 0,
            "content": "Negaram provimento.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.339,
                0.212,
                0.638,
                0.261
            ],
            "angle": 0,
            "content": "N. 6014—Capital — Appellante, Thomé Gomes Ferreira; appellado, Francisco de Souza Franco; relator, o sr. Juvenal Malheircs.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.357,
                0.259,
                0.51,
                0.272
            ],
            "angle": 0,
            "content": "Negaram provimento.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.341,
                0.27,
                0.638,
                0.307
            ],
            "angle": 0,
            "content": "N. 60'5—Capital—Appellaute, o juiz de de direito; appellados, Laura Hnd e outros; relator, o sr. Juvenal Malheiros.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.358,
                0.306,
                0.512,
                0.319
            ],
            "angle": 0,
            "content": "Negaram provimento.",
            "merge_prev": false
        },
        {
            "type": "doc_title",
            "bbox": [
                0.676,
                0.075,
                0.915,
                0.104
            ],
            "angle": 0,
            "content": "ACTOS FEDERAES"
        },
        {
            "type": "text",
            "bbox": [
                0.66,
                0.12,
                0.928,
                0.151
            ],
            "angle": 0,
            "content": "DECRETO N. 7917—DE 21 DE MARÇO\nDE 1910",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.644,
                0.156,
                0.943,
                0.186
            ],
            "angle": 0,
            "content": "Creia o Registro e Archivo Geral de Marcas para animaes",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.646,
                0.19,
                0.943,
                0.238
            ],
            "angle": 0,
            "content": "O Presidente da República dos Estados Unidos do Brazil, em execução da lei número 1606, de 29 de Dezembro de 1906, decreta:",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.646,
                0.237,
                0.945,
                0.318
            ],
            "angle": 0,
            "content": "Artigo 1.º E' creado o Registro e Archivo Geral de Marcas para animaes de raça bovina, cavaliar e muar, do acórdos com o regulamento que com esta baixa, assignado pelo ministro de Estado dos Negócios da Agricultura, Industria e Commeria.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.648,
                0.316,
                0.947,
                0.341
            ],
            "angle": 0,
            "content": "Artigo 2.º Revogam-se as disposições em contrário.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.648,
                0.339,
                0.948,
                0.366
            ],
            "angle": 0,
            "content": "Rio de Janeiro, 24 do Março de 1510, 89.º da Independência e 22.º da República.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.672,
                0.369,
                0.947,
                0.397
            ],
            "angle": 0,
            "content": "Nilo Proganha\nRodolpho Noguetra da Rocha Miranda.",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.098,
                0.412,
                0.887,
                0.433
            ],
            "angle": 0,
            "content": "Directoria de Agricultura — O TEMPO E A LAVOURA — Seção Meteorológica",
            "merge_prev": false
        },
